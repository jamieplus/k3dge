__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/
.DS_Store
logs/
.grok/
harnesses/

# protocol dispatch turnstile acks (ephemeral, per session)
.protocol-ack/

# local session receipt (attended_zones + epoch) — never commit; CI has no session to re-verify
.agent/session.json

# clean audit snapshot copy (temp-stripped working tree for kedge3 audit)
k3dge-audit/
# k3che 观测状态目录（命中率 jsonl 等，缓存组件自己的地盘）
.k3che/
# 快照对象库与物化区（内容寻存的派生物，永不入库）
.k3dge/
# 编排本地工单账（状态件，可见但不入版本；票据走 docs/tasks）
.agent/audit_jobs.json
# 审计条件清单同样是运行态投影（开跑即重写）：tracked 会让每次审计
# 都把工作树弄脏 ⇒ 落补丁相位被自家 DIRTY_TREE 判据挡（ADR-0004 §2.1.10）
.agent/audit_checklist.json
# 审计确认（人主观确认全版 audit 的本地记录）：运行态投影，不入库（ADR-0004 §2.1.14）
.agent/seal_ack.json
# 弹壳区：一次性施工脚本，seal 即清
/tmp/
# understand 技能产物（知识图谱 + 批次中间件，6MB 级派生物，永不入库）
.ua/
.mcp.json
