# k3dge external peer pipeline — declarative peers + action fallback chains
# Peers are equal (ADR-0006), not plugins. k3dge only routes + gates; lenses live in peers.
# Connection endpoints live in .mcp.json (k3dge mcp sync); this file defines flows only.
#
# EXECUTION MODEL: k3dge invokes the lens, it does NOT audit or score (sidecar, ADR-0006).
# `k3dge milestone seal` drives the lifecycle in THREE phases (ADR-0004 §2.1.9, one entry point):
#   phase 1 预审: align (Full Matrix, no prompt) + form gates; failure => fix and seal again
#   phase 2 审计: [checks.seal].actions 的 `audit` 节点 (MANDATORY) —— 版本前进定在此刻
#                 （审计正常返回即 bump，不管有没有报告；`skip`/空转一律 refused）
#   phase 3 审核后: archive + version + pointer + 记录（封版提交 trailer / tag）
# `k3dge milestone audit <id>` 仍是独立主动入口（同样的审计步骤，不封板）。
# Action-level only (ADR-0006 §2.3.8): the audit tool is `k3dit_run_audit_flow` — one call =
# "audit this target". k3dge never drives pass numbers; how many lenses k3dit runs is
# k3dit's private implementation. Per-call args come from the caller (scope/milestone).
# `blocking` is intentionally NOT a field: nothing in k3dge auto-runs a peer; the CLI
# explicitly invokes the named actions below (see milestone.run_seal_flow).

# 角色层（peer contract §0）：编排只认角色；角色→实现一处可换（含桩 bind = "dummy"）。
# 两类角色（v0.3）：gate 类走审计线/工件/基线/两态；service 类同步查询、失败即 skip，永不进放行链。
# 流程引用仍兼容 legacy 直名（k3dit.actions.*）；新流程一律走角色名（audit.*/cache.*）。
# 质量不在角色表：它是合并审计模块内的窗口（ADR-0025），无独立 peer。
[roles.audit]
bind = "k3dit"
# 审计腿形状：`bundle`＝冻结基线 → **命令行工具 k3dit** 产包 → 消费侧验包+落补丁（ADR-0025 §2.9.6）。
# `bind` 只声明"谁审"（工具名，和 `git` 同层）；本地命令行工具**不注册 peer、不声明 transport**。
# 2026-09-26 从 `ratchet` 迁来：棘轮要的 verb 走 mcp，而 k3dit 的 MCP 服务端面已退役（见下）。
mode = "bundle"
# 工具运行参数（k3dit 的两个旋钮，走声明面、不在腿里写死）：
#   k3dit_mode = "full"（判读+修+复核，待修=0 才算已审）| "audit-only"（只出证据、不构成封板依据）
#   k3dit_pins = "inplace"（钉留树）| "artifact"（钉只随包）
#   k3dit_scope = "src/k3dit/tools"（逗号分隔、相对仓根；空＝k3dit 缺省）——控制送审面，避免整仓一次审
#   k3dit_timeout = 整条 `k3dit audit` 子进程的**墙钟**天花板（秒；非 k3dit 席位层的探针）。
#     这是 k3dge 侧的平铺 subprocess 超时（`audit_bundle._run` → `communicate(timeout=)` 到点 `killpg`），
#     与 k3dit 的 `stall_after_sec` 探针**不是一回事**：探针管单席判活，本墙钟杀整轮。
#     真跑实测（M11，2026-09-29）：整仓审计仅 doc 窗 59 片 ≈ 2h ⇒ 缺省 7200s 到点被掐、
#     `hall export` 抢救出 `incomplete` 包、封板被拒。故抬到 6h 兜住整仓一轮；正解是把它改成
#     认探针的活性上限（pending，见 docs/reviews/LEFTOVERS.md）。
k3dit_mode = "full"
k3dit_pins = "inplace"
k3dit_scope = ""
k3dit_timeout = "21600"

[roles.cache]
bind = "k3che"
kind = "service"




# 质量是合并审计模块内的窗口（ADR-0025），不再是独立 peer：
# 无独立 quality peer / quality report/verify 腿。一份 12 列报告即一轮。

# Optional cache lens — NOT on the mandatory seal path. Degrades to `skip`.
[peers.k3che]
enabled = true

[peers.k3che.actions.search]
transports = [
  { provider = "mcp", tool = "k3che_search", timeout = 10 },
  { provider = "skip" },
]

[peers.k3che.actions.stats]
transports = [
  { provider = "mcp", tool = "k3che_stats", timeout = 8 },
  { provider = "skip" },
]

# 编排声明面只有一处：`[checks.*]`（缺省在 engine/gates.DEFAULTS，仓内可用
# 本文件的 [checks.*]/[gates.*] 覆盖；下游可配）。**外部 peer 步**声明为 `stages_produce` /
# `stages_verify`（action ref，交 run_action 走 mcp→cli→manual/skip），**内部动作**
# 声明为 `actions`（注册表 id）；两类 id 不混一张词表（ADR-0026 §2.1）。
#
# 审计流的两步即在此声明（原 [pipelines.on_seal_enter] / [on_pre_seal] 已迁走——
# 那两处只有 schema 校验、没有执行者，属"文档声称的机制不存在"）：
#   [checks.audit]
[checks.seal]
# 预审＝进**审计**的门槛（ADR-0004 §2.1.9 相位 1）。`align_pass` 由第一个动作
# `full_matrix` 满足（[nodes.full_matrix].satisfies）⇒ 清单显示 ⚙️，不需预先手跑 align。
preconditions = ["tasks_all_done", "align_pass", "guides_filled", "adrs_all_accepted",
                 "adr_landed", "adr_amend_format", "docs_normalized"]   # 耐久＝闸：规约化须在封板前做完
# 顺序＝三相位：预审(full_matrix) → 审计(audit) → 审核后(archive + 收摊清单 + 派生件清理)
# 已移出前置闸：audit_closed / evidence_chain（报告降为可选产物）、audit_fresh（边界改由
# `tag <M>=<B>` 表达）——见 ADR-0004 §2.1.3/§2.1.9/§2.1.10。
actions = ["full_matrix", "audit", "archive", "version_bump",
           "closure_note", "seal_record", "prune"]

[checks.align]
preconditions = ["tasks_all_done"]
actions = ["full_matrix"]

[checks.audit]
# 审计**不是外部步**：k3dit 是本地命令行工具（和 `git` 同层）⇒ bundle 腿按 argv 调用它、读包、
# 落树、落账；自证走工具子命令（`k3dit audit --verify`，在 `audit_bundle.consume` 内）。
# 显式置空：既表明"没有外部 produce/verify 步"，也避免声明一个解析不到的 action（声明面不许空转）。
stages_produce = []
stages_verify = []

["audit.actions.audit"]   # 一份必做（合并审计模块，ADR-0025）
stages_verify = ["audit.actions.verify"]   # 待修==0 的二次核对

[checks.sync]
actions = ["sync_extractors", "reconcile_adrs", "sync_domains",
           "sync_manual_docs", "sync_docs_index"]   # 顺序即声明序；各步性质见 [nodes.*]

[gates.audit_trigger]
c2_nesting_max = 5      # 审计建议触发：C2 嵌套阈值
volume_max = 8          # 审计建议触发：本轮体积阈值

[gates.search]
context_max = 3

[gates.markers]
max_note = 80
max_note_pending = 500

[gates.output]
default_lines = 10

# ── 编排节点属性（每个 action/precondition 的性质与失败语义；下游可配）──────
# 缺省在 engine/nodes.NODE_DEFAULTS（必须完整）。字段：
#   kind      projection（可幂等重算）| fact（写一次即历史）
#   on_error  stop（失败即停）| rollback（回滚该步）| continue（不中断，消息并入输出）
#   on_rerun  （仅 kind=fact）append | reject —— 重跑是追加还是拒绝
#   needs / produces  ctx 键名（这一步读/写哪些上下文字段；只声明键名，不声明结构）
# 未知 id 一律拒绝（不让声明空转）；失败经 gates.rejection 正规化为闭集 gate_id。

[nodes.archive]
kind = "fact"
on_error = "rollback"
on_rerun = "reject"        # 归档写一次即历史：已归档再跑应被拒（动作自身也会报"无任务可封"）
produces = ["archived_paths"]

[nodes.prune]
kind = "fact"
on_error = "continue"      # 派生件清理失败不该挡住封板
on_rerun = "append"

[nodes.closure_note]
kind = "projection"        # 收摊清单可重生成
on_error = "continue"

[nodes.version_bump]
kind = "fact"              # 版号前进＝写一次即历史（审计正常返回后才走这一步）
on_error = "continue"      # bump 失败不回滚已归档 tasks，只告警（ADR-0004 §2.3）
on_rerun = "append"

[nodes.seal_record]
kind = "fact"              # 封版提交 + 边界 tag：写一次即历史
on_error = "stop"          # 记录落不下 ⇒ 停（缺记录不得静默当已封）
on_rerun = "append"
produces = ["audit_baseline", "audit_seal_commit"]

[nodes.full_matrix]
kind = "projection"
on_error = "stop"
satisfies = ["align_pass"]   # 本动作跑 align 并写 align-pass marker ⇒ 该前置闸由 seal 自己满足
                             # （清单里显示 ⚙️，不算"需你先办"）

# ── bundle 审计腿（ADR-0025 §2.9.6 / k3dit 仓 0028 消费方）─────────────────────────
# 形状切换＝改一行（role 的 mode）：`bundle`（本地命令行工具，推荐）/`oneshot`（显式声明的外部
# produce/verify 步，给真正的对等 harness）。`ratchet` 已退休（声明它会被显式拒绝）。
#   活配置在本文件上面那节 `[roles.audit]`（**这里不再抄一遍**：抄了就成了"活配置 + 死副本"
#   两种坐标，改一处必漏另一处）。语义：k3dge 冻结基线 → 调 k3dit 产包 → 验包 → 按 apply_order 落补丁。
# cli 传输支持已知占位：`command = "k3dit audit --verify {bundle}"`（`{bundle}`/`{milestone_id}`/`{path}`）。
# 翻转前须知：bundle 腿需要 k3dit 在场（`K3DIT_BIN` 或 PATH/兄弟仓），且会真跑一次完整审计（分钟级、付费）。
