{
  "filename": "^(\\d{4})-[\\w-]+\\.md$",
  "h1": "^#\\s+ADR-{id}\\s*[:—-]",
  "sections": [
    "## 1. 上下文 (Context)",
    "## 2. 决策 (Decision)",
    "## 3. 产生后果 (Consequences)"
  ],
  "section_order": true,
  "frontmatter": {
    "Status": [
      "Accepted",
      "Draft",
      "Proposed",
      "Deprecated",
      "Rejected",
      "Superseded"
    ],
    "Date": "date"
  },
  "codes": {
    "filename": "ADR_FILENAME_MISMATCH",
    "h1": "ADR_FILENAME_MISMATCH",
    "frontmatter": "ADR_FRONTMATTER_MISSING",
    "sections": "ADR_SECTIONS_MISSING",
    "section_order": "ADR_SECTION_ORDER",
    "unique": "ADR_NUMBER_COLLISION",
    "amend": "ADR_AMEND_FORMAT",
    "amend_order": "ADR_AMEND_ORDER",
    "footnote_tail": "ADR_FOOTNOTE_TAIL",
    "amend_marker_text": "ADR_AMEND_MARKER_TEXT",
    "amend_ref": "ADR_AMEND_REF",
    "footnote_orphan": "ADR_FOOTNOTE_ORPHAN",
    "footnote_line": "ADR_FOOTNOTE_LINE",
    "footnote_seq": "ADR_FOOTNOTE_SEQ",
    "amend_draft": "ADR_AMEND_DRAFT",
    "amend_split": "ADR_AMEND_SPLIT"
  },
  "amend": {
    "enabled": true
  }
}
