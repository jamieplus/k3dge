#!/usr/bin/env bash
# k3dge commit-msg hook: enforce Conventional Commits and attach a lightweight
# attestation trailer so CI can detect commits that bypassed the governed path
# (e.g. `git commit --no-verify`). Activate via: git config core.hooksPath scripts
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/scripts/gate.py" ]; then
  echo "[k3dge] commit-msg: 仓根/治理件 gate.py 找不到（ROOT='$ROOT'）——拒绝提交" >&2
  exit 1
fi
if [ -z "${1:-}" ]; then
  echo "[k3dge] commit-msg: 缺提交信息文件参数" >&2
  exit 1
fi
# 消息文件必须真在：不存在时 `grep -q ... "$1"` 返回 2（错误）被 `!` 取反成"没有 trailer"，
# 于是走追加分支，而 `>>` 会**凭空造出**这个文件（343）
if [ ! -f "$1" ] || [ ! -r "$1" ]; then
  echo "[k3dge] commit-msg: 提交信息文件不存在或不可读：$1 —— 拒绝提交" >&2
  exit 1
fi

python3 "${ROOT}/scripts/gate.py" check-msg --file "$1" || exit 1

# 署名**由库就地改写**（`append_to_message`）：以前 hook 自己 `grep`+`>>` 补一行，两条实现会漂
# （空行分段、并入已有 trailer 块、剔除伪造行）⇒ hook 署的名 CI 读不回（374）。
# 库每轮重算并刷新 `k3dge-commit:` 行：`--amend`/tree 变了仍拿到新 token（ocr-125/142）。
if ! python3 "${ROOT}/scripts/gate.py" commit-attest --rewrite-file "$1"; then
  echo "[k3dge] commit-attest 改写失败：拒绝提交（缺 k3dge-commit 署名会被 CI 全量验拦下）" >&2
  exit 1
fi
