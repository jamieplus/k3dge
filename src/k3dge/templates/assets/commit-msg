#!/usr/bin/env bash
# k3dge commit-msg hook: enforce Conventional Commits and attach a lightweight
# attestation trailer so CI can detect commits that bypassed the governed path
# (e.g. `git commit --no-verify`). Activate via: git config core.hooksPath scripts
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/scripts/gate.py" ]; then
  echo "[k3dge] commit-msg: 仓根/治理件 gate.py 找不到（ROOT='$ROOT'）——拒绝提交" >&2
  exit 1
fi
if [ -z "${1:-}" ]; then
  echo "[k3dge] commit-msg: 缺提交信息文件参数" >&2
  exit 1
fi

python3 "${ROOT}/scripts/gate.py" check-msg --file "$1" || exit 1

if ! LINE="$(python3 "${ROOT}/scripts/gate.py" commit-attest)"; then
  echo "[k3dge] commit-attest 失败：拒绝提交（缺 k3dge-commit 署名会被 CI 全量验拦下）" >&2
  exit 1
fi
if ! printf '%s' "$LINE" | grep -Eq '^k3dge-commit: .+ @ .+ #[a-z]+$'; then
  echo "[k3dge] commit-attest 输出非法（应为一行 k3dge-commit trailer）：$LINE" >&2
  exit 1
fi
# 每次**刷新**该行（删旧再追加）：`--amend`/重跑会把旧 tree/旧窗算出的 token 带进来，
# 跳过会让 token 过期（内容改了 tree 变 ⇒ CI 重算 mismatch）；也挡"正文塞一行伪造署名骗过 hook"（ocr-125/142）。
if grep -q '^k3dge-commit: ' "$1"; then
  grep -v '^k3dge-commit: ' "$1" > "$1.k3dge-tmp" && mv "$1.k3dge-tmp" "$1"
fi
printf '\n%s\n' "$LINE" >> "$1"
