#!/usr/bin/env python3
"""k3dge git pre-commit 薄壳（本仓与下游共用；`pairs.PAIRS` 字节锁）。

三件事：
1. 定位 k3dge —— 本仓（`src/k3dge/`）或已安装的包；都拿不到 ⇒ WARN 后放行（工具坏不阻断提交）。
2. 调 `k3dge.engine.doc_gate.main()`：doc-gate / schema gate（含 `pure_refs` 引用闸）/ 排查闸。
   三层实现归 engine —— 可单测，也能随 `k3dge init` 到达下游（此前只活在本仓脚本里，下游拿不到）。
3. 有代码/规格/agent 配置改动时，再跑一致性闸 `scripts/gate.py`（进程动作留在薄壳）。

Activate:  git config core.hooksPath scripts
Self-test: python3 scripts/pre-commit --scan
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def _workspace() -> Path:
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else Path.cwd().resolve()


def _reexec_into_venv(ws: Path) -> None:
    """有仓内 venv 就换用它的解释器再跑一遍（k3dge 装在那里）。

    下游仓的 hook 由 git 用 `#!/usr/bin/env python3`（系统 python）启动，而 k3dge 通常装在
    仓内 `.venv`——不换解释器就 `import k3dge` 失败、文档三层闸被静默跳过（正是 D1 的形态）。
    """
    import os

    if os.environ.get("K3DGE_HOOK_REEXEC") == "1":
        return
    cand = ws / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    if cand.is_file():
        os.environ["K3DGE_HOOK_REEXEC"] = "1"
        os.execv(str(cand), [str(cand), str(Path(__file__).resolve()), *sys.argv[1:]])


def _load_doc_gate(ws: Path):
    if (ws / "src" / "k3dge" / "engine" / "__init__.py").is_file():
        sys.path.insert(0, str(ws / "src"))  # 自举仓：import 本仓源码，不需要 venv
    from k3dge.engine import doc_gate  # noqa: WPS433 — 延迟导入：先定位才知道从哪导

    return doc_gate


def main() -> int:
    ws = _workspace()
    _reexec_into_venv(ws)
    try:
        doc_gate = _load_doc_gate(ws)
    except Exception as exc:  # 工具坏不得阻断所有提交（与 downgrade 口径一致）
        print(f"[k3dge doc-gate] WARN: k3dge 不可导入（{exc}）→ 跳过文档/结构闸")
        return 0
    doc_gate.set_workspace(ws)
    rc = doc_gate.main()
    if rc:
        return rc
    files = doc_gate.staged_files()
    if doc_gate.relevant_for_check(files):
        print("[k3dge check] running consistency gate...", flush=True)
        return subprocess.call([sys.executable, str(ws / "scripts" / "gate.py")])
    print("[k3dge check] skipped (no code/spec/agent changes in this commit)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
