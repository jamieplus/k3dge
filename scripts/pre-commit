#!/usr/bin/env python3
"""k3dge git pre-commit 薄壳（本仓与下游共用；`pairs.PAIRS` 字节锁）。

三件事：
1. 定位 k3dge —— 本仓（`src/k3dge/`）或已安装的包；都拿不到 ⇒ WARN 后放行（工具坏不阻断提交）。
2. 调 `k3dge.engine.doc_gate.main()`：doc-gate / schema gate（含 `pure_refs` 引用闸）/ 排查闸。
   三层实现归 engine —— 可单测，也能随 `k3dge init` 到达下游（此前只活在本仓脚本里，下游拿不到）。
3. 有代码/规格/agent 配置改动时，再跑一致性闸 `scripts/gate.py`（进程动作留在薄壳）。

Activate:  git config core.hooksPath scripts
Self-test: python3 scripts/pre-commit --scan
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def _workspace() -> Path:
    # git 不在 PATH / 超时 / rev-parse 失败 / 空 stdout ⇒ 回落 **hook 自身所在仓**
    # （`<ws>/scripts/pre-commit`，比 cwd 可靠）并出声，避免对可能不是提交仓的 cwd 跑闸（ocr2-382）。
    # timeout 必须有，且 `TimeoutExpired` 不是 `OSError`，要一并接住。
    fallback = Path(__file__).resolve().parents[1]
    try:
        r = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"[k3dge] WARN: git 定位工作区失败（{exc}）→ 回落 hook 所在目录 {fallback}", file=sys.stderr)
        return fallback
    if r.returncode == 0 and r.stdout.strip():
        return Path(r.stdout.strip())
    print(f"[k3dge] WARN: git rev-parse 未给出仓根（rc={r.returncode}）→ 回落 hook 所在目录 {fallback}",
          file=sys.stderr)
    return fallback


def _reexec_into_venv(ws: Path) -> None:
    """有仓内 venv 就换用它的解释器再跑一遍（k3dge 装在那里）。

    下游仓的 hook 由 git 用 `#!/usr/bin/env python3`（系统 python）启动，而 k3dge 通常装在
    仓内 `.venv`——不换解释器就 `import k3dge` 失败、文档三层闸被静默跳过（正是 D1 的形态）。
    """
    import os

    if os.environ.get("K3DGE_HOOK_REEXEC") == "1":
        return
    cand = ws / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    if not (cand.is_file() and os.access(str(cand), os.X_OK)):
        return
    os.environ["K3DGE_HOOK_REEXEC"] = "1"
    try:
        os.execv(str(cand), [str(cand), str(Path(__file__).resolve()), *sys.argv[1:]])
    except OSError:
        os.environ.pop("K3DGE_HOOK_REEXEC", None)      # execv 失败 ⇒ 清哨兵，回落当前解释器


def _load_doc_gate(ws: Path):
    """定位 doc_gate：**已装的那份优先**，只有导不进来才回落到仓内 `ws/src`。

    旧实现无条件 `sys.path.insert(0, ws/src)`：它总盖过上一步 re-exec 进来的 venv 版本
    ⇒ 换解释器的意义被抵消，同一个提交里还并存两套实现（367）。
    """
    try:
        from k3dge.engine import doc_gate  # noqa: PLC0415 — 延迟导入：先定位才知道从哪导

        return doc_gate
    except ImportError:
        if not (ws / "src" / "k3dge" / "engine" / "__init__.py").is_file():
            # 没有仓内兜底 ⇒ **在 except 内裸 raise** 重抛原 ImportError（含真实模块名/原因）。
            # 旧实现把 `raise` 留在 except 块之后，异常已被清除 ⇒ 只剩
            # `RuntimeError: No active exception to re-raise`，真实原因丢失（ocr2-383）。
            raise
        sys.path.append(str(ws / "src"))   # 追加（不是插到 [0]）：自举仓兜底，不遮蔽已装版本
        from k3dge.engine import doc_gate  # noqa: PLC0415

        return doc_gate


def _run_consistency_gate(ws: Path, relevant) -> int:
    """一致性闸 `scripts/gate.py` **独立于 k3dge import**（ocr-027/028）：import 失败或闸崩时也要跑，
    否则 contract hash / seal / 文档索引等确定性阻断项会被一行 WARN 静默旁路。
    `relevant is False` ⇒ 明确无关，跳过；True/None ⇒ 跑（None＝拿不到判定核 ⇒ fail-closed）。"""
    if relevant is False:
        print("[k3dge check] skipped (no code/spec/agent changes in this commit)")
        return 0
    gate = ws / "scripts" / "gate.py"
    if not gate.is_file():      # 治理件缺失：出声 + 修复指引；工具坏不得阻断所有提交（ocr-177）
        print(f"[k3dge check] WARN: {gate} 缺失 → 跳过一致性闸；请先 ./k3dge-init.sh", file=sys.stderr)
        return 0
    print("[k3dge check] running consistency gate...", flush=True)
    try:
        # 固定 cwd=ws（闸的判据不该随 hook 调用者的 cwd 漂移）+ timeout（挂住＝提交永久卡死，ocr-177）。
        r = subprocess.run([sys.executable, str(gate)], cwd=str(ws), timeout=1800)
    except subprocess.TimeoutExpired:
        print("[k3dge check] FAIL: 一致性闸超时（>1800s）", file=sys.stderr)
        return 1
    except OSError as exc:      # 连 gate.py 都跑不动 ⇒ 工具坏，放行（不阻断提交）
        print(f"[k3dge check] WARN: consistency gate 不可执行（{exc}）→ 放行", file=sys.stderr)
        return 0
    if r.returncode < 0:        # 被信号杀掉：把负码转成可读的红，而不是"不透明失败"
        print(f"[k3dge check] FAIL: 一致性闸被信号终止（signal {-r.returncode}）", file=sys.stderr)
        return 1
    return r.returncode


def main() -> int:
    ws = Path(__file__).resolve().parents[1]
    try:
        ws = _workspace()
        _reexec_into_venv(ws)
    except Exception as exc:      # 环境探测失败不得阻断提交，但**也不能连带跳过一致性闸**（ocr2-384）
        print(f"[k3dge] WARN: 环境探测失败（{exc}）→ 用 {ws} 继续（一致性闸仍跑）", file=sys.stderr)
    try:
        doc_gate = _load_doc_gate(ws)
    except Exception as exc:      # k3dge 不可导入 ⇒ 文档/结构闸降级，但**一致性闸仍跑**
        print(f"[k3dge doc-gate] WARN: k3dge 不可导入（{exc}）→ 跳过文档/结构闸", file=sys.stderr)
        return _run_consistency_gate(ws, None)
    try:
        doc_gate.set_workspace(ws)
        rc = doc_gate.main(sys.argv[1:])   # 显式传参（366）：薄壳的 `--scan` 不再靠引擎偷读 sys.argv
        if rc:
            return rc
        relevant = doc_gate.relevant_for_check(doc_gate.staged_files())
    except Exception as exc:      # 闸**自身崩溃**（非判定失败）⇒ WARN 放行文档/结构闸，一致性闸照跑
        print(f"[k3dge doc-gate] WARN: 闸自身异常（{exc}）→ 跳过文档/结构闸", file=sys.stderr)
        relevant = None
    return _run_consistency_gate(ws, relevant)


if __name__ == "__main__":
    sys.exit(main())
