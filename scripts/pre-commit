#!/usr/bin/env python3
"""k3dge doc-gate (managed git pre-commit hook).

STRUCTURE-ONLY gate. Every top-level docs/ domain directory must carry a
README.md whose `## 文档编撰规则 (Document Authoring Rules)` anchor section
states that domain's soft authoring rules. For each staged managed document,
the hook checks the README of its top-level domain (docs/<domain>/README.md):
  - no README            -> commit blocked (mandatory)
  - README lacks anchor  -> commit blocked (README structure broken)
  - README has anchor    -> governed, intact (pass)

Nested content dirs (docs/specs/<domain>/, docs/*/archive/, ...) are governed
by their top-level domain README; they are not separate governed units.

Content (rule text, per-doc frontmatter/sections, index sync) is NOT validated:
protocols are soft rules followed by reading the domain README.

Routing is implicit: the protocol IS the README in the document's own domain dir.
No central registry, no hardcoded prefixes.

Activate:  git config core.hooksPath scripts
Self-test: python3 scripts/pre-commit --scan
"""
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

WS = Path(__file__).resolve().parent.parent
ANCHOR = "## 文档编撰规则 (Document Authoring Rules)"


def staged_files() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        cwd=WS, capture_output=True, text=True,
    )
    return [p for p in out.stdout.splitlines()]


# k3dge check only matters when code / spec / agent-config / templates change.
_CHECK_PREFIXES = ("src/", "docs/specs/", ".agent/", "src/k3dge/templates/")
_CHECK_SUFFIXES = (".py", "manifest.json", "pyproject.toml", ".toml")


def relevant_for_check(files: list[str]) -> bool:
    return any(
        f.startswith(_CHECK_PREFIXES) or f.endswith(_CHECK_SUFFIXES) for f in files
    )


def check_one(rel: str) -> list[str]:
    parts = Path(rel).parts
    domain = parts[1] if len(parts) > 1 else ""
    rm = WS / "docs" / domain / "README.md"
    if not rm.exists():
        return [f"{rm.relative_to(WS)}: missing — every docs subdir must have a README.md"]
    if ANCHOR not in rm.read_text(encoding="utf-8"):
        return [f"{rm.relative_to(WS)}: anchor section `{ANCHOR}` missing (README structure broken)"]
    return []


def main() -> int:
    if "--scan" in sys.argv:
        missing: list[str] = []
        for d in sorted(p for p in (WS / "docs").iterdir() if p.is_dir()):
            rm = d / "README.md"
            label = str(d.relative_to(WS)) + "/README.md"
            if not rm.exists():
                missing.append(f"{label}: missing")
            elif ANCHOR not in rm.read_text(encoding="utf-8"):
                missing.append(f"{label}: no anchor")
        if missing:
            print("[k3dge doc-gate] FAIL: docs subdirs missing README/anchor:")
            for m in missing:
                print(f"  - {m}")
            return 1
        total = len([p for p in (WS / "docs").iterdir() if p.is_dir()])
        print(f"[k3dge doc-gate] PASS: {total} docs subdirs have README + anchor")
        return 0

    rc = 0
    files = staged_files()
    doc_files = [f for f in files if f.startswith("docs/") and f.endswith(".md") and not f.endswith("/README.md")]

    # doc-gate: only when docs actually changed
    if doc_files:
        errs: list[str] = []
        for f in doc_files:
            errs.extend(check_one(f))
        if errs:
            print("[k3dge doc-gate] FAIL: README structure broken -> commit blocked")
            for e in errs:
                print(f"  - {e}")
            print("[k3dge doc-gate] add/fix the domain README (with anchor), then commit (or `git commit --no-verify`)")
            rc = 1
        else:
            print(f"[k3dge doc-gate] PASS: {len(doc_files)} managed doc(s) — README structure intact")
    else:
        print("[k3dge doc-gate] skipped (no docs changed in this commit)")

    # consistency gate (k3dge check): only when code/spec/agent changed
    if relevant_for_check(files):
        print("[k3dge check] running consistency gate...", flush=True)
        check_rc = subprocess.call([sys.executable, str(WS / "scripts" / "gate.py")])
        if check_rc != 0:
            rc = check_rc
    else:
        print("[k3dge check] skipped (no code/spec/agent changes in this commit)")
    return rc


if __name__ == "__main__":
    sys.exit(main())
